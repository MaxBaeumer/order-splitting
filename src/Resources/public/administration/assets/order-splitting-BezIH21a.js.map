{% block swag_order_split_deliveries %}
<mt-card class="swag-order-split-deliveries"
         :title="$tc('swag-order-splitting.card.title')"
         position-identifier="swag-order-split-deliveries">

    <template v-if="!hasMultipleDeliveries">
        <p class="swag-order-split-deliveries__empty">
            {{ $tc('swag-order-splitting.card.singleDelivery') }}
        </p>
    </template>

    <template v-else>
        <div v-for="(delivery, index) in deliveries"
             :key="delivery.id"
             class="swag-order-split-deliveries__delivery">

            <h4 class="swag-order-split-deliveries__heading">
                {{ $tc('swag-order-splitting.card.delivery') }} {{ index + 1 }}
            </h4>

            <p class="swag-order-split-deliveries__address">
                <mt-icon name="regular-map-marker" size="14px" />
                {{ addressLine(delivery) }}
            </p>

            <ul class="swag-order-split-deliveries__items">
                <li v-for="position in positionsFor(delivery)" :key="position.id">
                    {{ position.quantity }} &times; {{ lineItemLabel(position) }}
                </li>
            </ul>

            <p class="swag-order-split-deliveries__shipping">
                {{ $tc('swag-order-splitting.card.shipping') }}:
                {{ shippingCost(delivery) }} {{ currencyCode }}
            </p>
        </div>
    </template>
</mt-card>
{% endblock %}
